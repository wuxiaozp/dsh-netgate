  "homepage": "https://github.com/wuxiaozp/dsh-netgate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuxiaozp/dsh-netgate.git"
  },
  "bugs": {
    "url": "https://github.com/wuxiaozp/dsh-netgate/issues"
  },
  "files": [
    "lib",
    "netguard",
    "cordis.patch.yml",
    "install.sh",
    "README.md",
    "LICENSE",
    "docs/index.json"
  ]
