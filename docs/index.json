  "plugins": [
    {
      "name": "dsh-netgate",
      "title": {
        "zh": "网闸·基础版",
        "en": "NetGate · Basic"
      },
      "description": {
        "zh": "联网总开关：移除联网搜索与网页抓取，并在进程层切断 bash 及其子进程的外网连接；关闭后还能开严格模式，连命令行一起停用。本地写代码、编译、测试不受影响。",
        "en": "Master switch: removes web search and fetch, cuts every bash child from the network, and offers a strict mode that also removes the shell. Local coding, builds and tests keep working."
      },
      "author": "wuxiaozp",
      "homepage": "https://github.com/wuxiaozp/dsh-netgate#readme",
