  "plugins": [
    {
      "name": "dsh-netgate",
      "title": {
        "zh": "网闸·基础版",
        "en": "NetGate · Basic"
      },
      "description": {
        "zh": "手机端（dsh-go）：移除联网搜索与网页抓取，命令守卫 + 进程级断网，本地编辑通常照常，编译/装包等联网步骤可能失败。电脑端是另一个包 dsh-netgate-win 0.1.9，两个版本号独立、不能互相安装；Windows 端没有进程级断网。",
        "en": "Phone (dsh-go): removes web search/fetch, guards shell commands and blocks the network at the process level; local editing usually keeps working; networked builds may fail. The Windows build is a separate package (dsh-netgate-win 0.1.9) without process-level blocking."
      },
      "author": "wuxiaozp",
