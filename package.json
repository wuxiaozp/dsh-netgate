{
  "name": "dsh-netgate",
  "version": "0.3.0",
  "type": "module",
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "网闸·基础版",
      "en": "NetGate · Basic"
    },
    "icon": "globe",
